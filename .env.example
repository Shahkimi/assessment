# Copy to .env (cp .env.example .env) and change the values before running.
# .env is git-ignored. Never commit real secrets.

# --- PostgreSQL ---
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me-db-password

# --- Backend / JWT ---
# Signing key, minimum 32 characters. Generate: openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_ISSUER=taskflow-api
JWT_AUDIENCE=taskflow-web
JWT_EXPIRY_MINUTES=60

# --- Demo login (assessment allows a hardcoded user) ---
DEMO_USER_EMAIL=admin@taskflow.com
DEMO_USER_PASSWORD=Admin@123

# --- Host ports ---
FRONTEND_PORT=4200
BACKEND_PORT=5000
POSTGRES_PORT=5432
